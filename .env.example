# ====================================================================
# orbyn-lead-qualifier — copia este archivo a .env y rellena las claves
# Nunca subas .env al repo.
# ====================================================================

# --- Telegram (obligatorio) ---
TELEGRAM_TOKEN=PEGA_AQUI_EL_TOKEN_DEL_BOT
# chat ids permitidos separados por coma. Vacio = abierto a todos.
ALLOWED_CHAT_IDS=

# --- LLM providers (con failover automatico en este orden) ---
# Activo por defecto: groq (rapido y gratuito).
LLM_PROVIDER=groq
LLM_FALLBACK_ORDER=groq,cerebras,mistral,sambanova,nvidia,gemini,openrouter

# Cualquier provider con clave vacia se omite en la cascada.
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Google Sheets (opcional al arranque; el bot funciona sin esto) ---
# Ruta al JSON del service account de Google Cloud con permisos sobre la Sheet.
GOOGLE_SERVICE_ACCOUNT_FILE=
# ID de la hoja (la cadena larga en la URL de la Sheet).
GOOGLE_SHEET_ID=
# Nombre de la pestania donde se escriben las filas.
GOOGLE_SHEET_TAB=leads

# --- Comportamiento ---
LOG_LEVEL=INFO
# limite blando de caracteres por mensaje del usuario antes de truncar.
MAX_INPUT_CHARS=2000
# limite de leads por chat_id por minuto (rate limit basico)
RATE_LIMIT_PER_MINUTE=10
